# From this directory: `just` = smoke; `just linux` / `just linux arm` = musl cross-build (see linux.just).
# Smoke needs MySQL + MARTY_MYSQL_* env vars or ./marty.conf (passed via MARTY_CONFIG; see README).
# Requires: bash, python3 (cargo metadata in `install`).

default: smoke

mod linux

setup:
    #!/usr/bin/env bash
    set -euo pipefail
    HERE="{{ justfile_directory() }}"
    ROOT="$(cd "$HERE/../.." && pwd)"
    just -f "$ROOT/justfile" setup

build:
    #!/usr/bin/env bash
    set -euo pipefail
    HERE="{{ justfile_directory() }}"
    ROOT="$(cd "$HERE/../.." && pwd)"
    cd "$ROOT"
    cargo build -p marty-07-mysql --release

install: build
    #!/usr/bin/env bash
    set -euo pipefail
    HERE="{{ justfile_directory() }}"
    ROOT="$(cd "$HERE/../.." && pwd)"
    cd "$ROOT"
    T="$(cargo metadata --format-version=1 --no-deps | python3 -c 'import json,sys; print(json.load(sys.stdin)["target_directory"])')"
    BIN="$T/release/marty-07-mysql"
    test -f "$BIN"
    mkdir -p "$HERE/cgi-bin"
    cp -f "$BIN" "$HERE/cgi-bin/marty-07-mysql"
    chmod +x "$HERE/cgi-bin/marty-07-mysql"
    # Never copy the conf into cgi-bin/: the binary does not look there (see README).
    rm -f "$HERE/cgi-bin/marty_mysql.conf" "$HERE/cgi-bin/marty.conf"

run-server:
    #!/usr/bin/env bash
    set -euo pipefail
    HERE="{{ justfile_directory() }}"
    ROOT="$(cd "$HERE/../.." && pwd)"
    cd "$HERE"
    if [[ -f "$HERE/marty.conf" && -z "${MARTY_CONFIG:-}" ]]; then export MARTY_CONFIG="$HERE/marty.conf"; fi
    exec cargo run --manifest-path "$ROOT/Cargo.toml" -p _http-cgi-server

smoke: setup install
    #!/usr/bin/env bash
    set -euo pipefail
    HERE="{{ justfile_directory() }}"
    ROOT="$(cd "$HERE/../.." && pwd)"
    if ! command -v hurl >/dev/null 2>&1; then
      echo "error: hurl not on PATH after \`just setup\` (https://hurl.dev). Add Cargo bin to PATH, e.g. export PATH=\"\$HOME/.cargo/bin:\$PATH\"" >&2
      exit 1
    fi
    # The CGI inherits _http-cgi-server's env: pass ./marty.conf explicitly via MARTY_CONFIG.
    if [[ -f "$HERE/marty.conf" && -z "${MARTY_CONFIG:-}" ]]; then
      export MARTY_CONFIG="$HERE/marty.conf"
    elif [[ -n "${MARTY_CONFIG:-}" ]]; then
      :
    elif [[ -n "${MARTY_MYSQL_USER:-}" && -n "${MARTY_MYSQL_DATABASE:-}" ]]; then
      :
    else
      echo "error: configure MySQL — copy marty.conf.example → marty.conf or set MARTY_MYSQL_USER + MARTY_MYSQL_DATABASE" >&2
      if [[ -f "$HERE/marty_mysql.conf" ]]; then
        echo "hint: marty_mysql.conf is the old name; rename it to marty.conf and prefix keys with MARTY_MYSQL_ (see marty.conf.example)" >&2
      fi
      exit 1
    fi
    bash "$ROOT/scripts/cgi-example-smoke.sh" "$HERE"
