# Apache: Marty CGI mounts on one vhost (same DocumentRoot, binaries under cgi-bin/).
# Merge into your .htaccess or use as a starting point.
# Requires: mod_rewrite, AllowOverride FileInfo (or All), Options +FollowSymLinks as needed.
# Generated by marty::htaccess.
#
# Short URLs (internal rewrite, [PT] passes to CGI).
# Full CGI URLs still work, e.g. /cgi-bin/<binary>/…

<IfModule mod_rewrite.c>
RewriteEngine On
# If the app lives in a subdirectory, set the prefix here, e.g. RewriteBase /myapp/
#RewriteBase /
RewriteRule ^basic/?$ cgi-bin/marty-01-basic [L,PT]
RewriteRule ^routing/(.+)$ cgi-bin/marty-02-routing/$1 [L,PT]
RewriteRule ^routing/?$ cgi-bin/marty-02-routing [L,PT]
RewriteRule ^session/?$ cgi-bin/marty-03-session [L,PT]
RewriteRule ^cookies/?$ cgi-bin/marty-04-cookies [L,PT]
RewriteRule ^sqlite/?$ cgi-bin/marty-05-sqlite [L,PT]
RewriteRule ^mysql/?$ cgi-bin/marty-07-mysql [L,PT]
</IfModule>
