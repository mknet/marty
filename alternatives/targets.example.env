# Copy to targets.env (gitignored) and fill after deploy.
# Each *_COMPLEX_URL / *_SYNC_URL is the path prefix before /primes|/fibonacci|/matrix.
#
# AWS:     Function URL origin (no trailing path)     → …/primes/400000?salt=0
# Azure:   https://<app>.azurewebsites.net/api        → …/api/primes/…
# CF:      https://marty-alt-cf-02-complex.<sub>.workers.dev
# Scaleway: https://<domain>  (function domain_name)
# Hosting: https://host/cgi-bin/marty-sync

AWS_COMPLEX_URL=
AZURE_COMPLEX_URL=
CF_COMPLEX_URL=
SCW_COMPLEX_URL=
HETZNER_SYNC_URL=
ALLINKL_SYNC_URL=
