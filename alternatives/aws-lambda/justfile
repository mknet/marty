# AWS Lambda alternatives — `just deploy` / `just destroy` from this directory.
# Requires: AWS CLI ≥ 2.32, just, cargo-lambda (auto-installed).
#
# Default region eu-west-1. Override: `just login region=us-east-1` or `AWS_REGION=…`.
#
#   just deploy                # Lambdas + DynamoDB (no RDS)
#   just deploy with_rds=1     # also smallest public MySQL RDS + wire MYSQL_* (costs money)
#   just destroy               # Lambdas + DynamoDB + our RDS instance if present

region := env("AWS_REGION", env("AWS_DEFAULT_REGION", "eu-west-1"))
table_02 := "alt-aws-lambda-02-user"
iam_role := env("CARGO_LAMBDA_IAM_ROLE", "")
fn_01 := "alt-aws-lambda-01-basic"
fn_02 := "alt-aws-lambda-02-dynamodb"
fn_03 := "alt-aws-lambda-03-mysql"
rds_id := "alt-aws-lambda-03-mysql"
rds_sg_name := "alt-aws-lambda-03-mysql-sg"
rds_user := "marty"
rds_db := "marty"
rds_creds := justfile_directory() / ".rds-credentials"

export AWS_REGION := region
export AWS_DEFAULT_REGION := region

default:
    @just --list

# Short-lived AWS credentials (opens browser) + pin default region for this profile.
login:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "region={{ region }} (override: just login region=us-east-1)"
    aws login
    aws configure set region "{{ region }}"
    aws sts get-caller-identity
    echo "default region: $(aws configure get region)"

login-remote:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "region={{ region }}"
    aws login --remote
    aws configure set region "{{ region }}"
    aws sts get-caller-identity

whoami:
    #!/usr/bin/env bash
    set -euo pipefail
    aws sts get-caller-identity
    echo "AWS_REGION={{ region }}"
    echo "configured region: $(aws configure get region 2>/dev/null || echo '(unset)')"

# Version check must be `cargo lambda -V` (cargo subcommand); `cargo-lambda --version` breaks.
install-cargo-lambda:
    #!/usr/bin/env bash
    set -euo pipefail
    export PATH="${HOME}/.cargo/bin:${PATH}"
    if cargo lambda -V >/dev/null 2>&1; then
      cargo lambda -V
      exit 0
    fi
    cargo install cargo-lambda --locked
    cargo lambda -V

# Build one example: `just build-one 02_dynamodb`
build-one example: install-cargo-lambda
    #!/usr/bin/env bash
    set -euo pipefail
    export PATH="${HOME}/.cargo/bin:${PATH}"
    cd "{{ justfile_directory() }}/{{ example }}"
    cargo lambda build --release --arm64

build: (build-one "01_basic") (build-one "02_dynamodb") (build-one "03_mysql")

watch example="01_basic": install-cargo-lambda
    #!/usr/bin/env bash
    set -euo pipefail
    export PATH="${HOME}/.cargo/bin:${PATH}"
    cd "{{ justfile_directory() }}/{{ example }}"
    cargo lambda watch

[private]
_ensure-table-02:
    #!/usr/bin/env bash
    set -euo pipefail
    eval "$(aws configure export-credentials --format env)"
    if aws dynamodb describe-table --table-name "{{ table_02 }}" --region "{{ region }}" >/dev/null 2>&1; then
      echo "table {{ table_02 }} already exists"
      exit 0
    fi
    aws dynamodb create-table \
      --table-name "{{ table_02 }}" \
      --attribute-definitions AttributeName=id,AttributeType=S \
      --key-schema AttributeName=id,KeyType=HASH \
      --billing-mode PAY_PER_REQUEST \
      --region "{{ region }}"
    aws dynamodb wait table-exists --table-name "{{ table_02 }}" --region "{{ region }}"
    echo "table {{ table_02 }} ready"

[private]
_policy-dynamodb:
    #!/usr/bin/env bash
    set -euo pipefail
    eval "$(aws configure export-credentials --format env)"
    FN="{{ fn_02 }}"
    ROLE_ARN="$(aws lambda get-function-configuration \
      --function-name "$FN" --region "{{ region }}" \
      --query 'Role' --output text)"
    ROLE_NAME="${ROLE_ARN##*/}"
    ACCOUNT="$(aws sts get-caller-identity --query Account --output text)"
    TABLE_ARN="arn:aws:dynamodb:{{ region }}:${ACCOUNT}:table/{{ table_02 }}"
    POLICY_FILE="$(mktemp)"
    trap 'rm -f "$POLICY_FILE"' EXIT
    printf '%s\n' \
      '{' \
      '  "Version": "2012-10-17",' \
      '  "Statement": [{' \
      '    "Effect": "Allow",' \
      '    "Action": ["dynamodb:PutItem", "dynamodb:Scan", "dynamodb:DescribeTable"],' \
      "    \"Resource\": \"${TABLE_ARN}\"" \
      '  }]' \
      '}' > "$POLICY_FILE"
    aws iam put-role-policy \
      --role-name "$ROLE_NAME" \
      --policy-name "${FN}-dynamodb" \
      --policy-document "file://${POLICY_FILE}"
    echo "attached DynamoDB policy to role ${ROLE_NAME}"

# Smallest public MySQL on default VPC (db.t4g.micro). Demo SG opens 3306 to the world — destroy after use.
[private]
_ensure-rds:
    #!/usr/bin/env bash
    set -euo pipefail
    eval "$(aws configure export-credentials --format env)"
    REGION="{{ region }}"
    CREDS="{{ rds_creds }}"
    ID="{{ rds_id }}"
    USER="{{ rds_user }}"
    DB="{{ rds_db }}"

    if aws rds describe-db-instances --db-instance-identifier "$ID" --region "$REGION" >/dev/null 2>&1; then
      echo "RDS $ID already exists"
    else
      echo "creating RDS MySQL $ID (db.t4g.micro, public) — several minutes + ongoing cost until destroy"
      VPC="$(aws ec2 describe-vpcs --region "$REGION" --filters Name=isDefault,Values=true \
        --query 'Vpcs[0].VpcId' --output text)"
      if [[ -z "$VPC" || "$VPC" == "None" ]]; then
        echo "error: no default VPC in $REGION" >&2
        exit 1
      fi
      SG_ID="$(aws ec2 describe-security-groups --region "$REGION" \
        --filters Name=group-name,Values={{ rds_sg_name }} Name=vpc-id,Values="$VPC" \
        --query 'SecurityGroups[0].GroupId' --output text 2>/dev/null || true)"
      if [[ -z "$SG_ID" || "$SG_ID" == "None" ]]; then
        SG_ID="$(aws ec2 create-security-group --region "$REGION" \
          --group-name "{{ rds_sg_name }}" \
          --description "Marty alt 03_mysql demo (open MySQL; destroy after use)" \
          --vpc-id "$VPC" \
          --query GroupId --output text)"
        aws ec2 create-tags --region "$REGION" --resources "$SG_ID" \
          --tags Key=Name,Value={{ rds_sg_name }} Key=marty-alt,Value=03_mysql
        aws ec2 authorize-security-group-ingress --region "$REGION" \
          --group-id "$SG_ID" --protocol tcp --port 3306 --cidr 0.0.0.0/0 >/dev/null
      fi

      if [[ -f "$CREDS" ]]; then
        # shellcheck disable=SC1090
        source "$CREDS"
        PASS="${MYSQL_PASSWORD:?}"
      else
        PASS="$(openssl rand -base64 24 | tr -d '/+=' | head -c 24)"
        umask 077
        printf 'MYSQL_USER=%s\nMYSQL_PASSWORD=%s\nMYSQL_DATABASE=%s\nMYSQL_PORT=3306\n' \
          "$USER" "$PASS" "$DB" > "$CREDS"
      fi

      aws rds create-db-instance \
        --region "$REGION" \
        --db-instance-identifier "$ID" \
        --db-instance-class db.t4g.micro \
        --engine mysql \
        --master-username "$USER" \
        --master-user-password "$PASS" \
        --allocated-storage 20 \
        --storage-type gp3 \
        --db-name "$DB" \
        --vpc-security-group-ids "$SG_ID" \
        --publicly-accessible \
        --backup-retention-period 0 \
        --no-multi-az \
        --no-deletion-protection \
        --tags Key=marty-alt,Value=03_mysql >/dev/null
    fi

    echo "waiting for RDS $ID to become available…"
    aws rds wait db-instance-available --db-instance-identifier "$ID" --region "$REGION"
    HOST="$(aws rds describe-db-instances --db-instance-identifier "$ID" --region "$REGION" \
      --query 'DBInstances[0].Endpoint.Address' --output text)"
    PORT="$(aws rds describe-db-instances --db-instance-identifier "$ID" --region "$REGION" \
      --query 'DBInstances[0].Endpoint.Port' --output text)"

    if [[ ! -f "$CREDS" ]]; then
      echo "error: missing $CREDS (password unknown for existing instance)" >&2
      exit 1
    fi
    # refresh host/port in creds file
    # shellcheck disable=SC1090
    source "$CREDS"
    umask 077
    printf 'MYSQL_HOST=%s\nMYSQL_PORT=%s\nMYSQL_USER=%s\nMYSQL_PASSWORD=%s\nMYSQL_DATABASE=%s\n' \
      "$HOST" "$PORT" "${MYSQL_USER:-$USER}" "$MYSQL_PASSWORD" "${MYSQL_DATABASE:-$DB}" > "$CREDS"
    echo "RDS endpoint: $HOST:$PORT (creds in $CREDS)"

[private]
_wire-mysql-env:
    #!/usr/bin/env bash
    set -euo pipefail
    eval "$(aws configure export-credentials --format env)"
    CREDS="{{ rds_creds }}"
    # shellcheck disable=SC1090
    source "$CREDS"
    aws lambda update-function-configuration \
      --function-name "{{ fn_03 }}" \
      --region "{{ region }}" \
      --environment "Variables={MYSQL_HOST=${MYSQL_HOST},MYSQL_PORT=${MYSQL_PORT},MYSQL_USER=${MYSQL_USER},MYSQL_PASSWORD=${MYSQL_PASSWORD},MYSQL_DATABASE=${MYSQL_DATABASE}}" \
      >/dev/null
    aws lambda wait function-updated --function-name "{{ fn_03 }}" --region "{{ region }}"
    echo "wired MYSQL_* onto {{ fn_03 }}"

[private]
_destroy-rds:
    #!/usr/bin/env bash
    set -euo pipefail
    eval "$(aws configure export-credentials --format env)"
    REGION="{{ region }}"
    ID="{{ rds_id }}"
    if aws rds describe-db-instances --db-instance-identifier "$ID" --region "$REGION" >/dev/null 2>&1; then
      echo "deleting RDS $ID (skip final snapshot)…"
      aws rds delete-db-instance \
        --db-instance-identifier "$ID" \
        --region "$REGION" \
        --skip-final-snapshot \
        --delete-automated-backups >/dev/null
      aws rds wait db-instance-deleted --db-instance-identifier "$ID" --region "$REGION"
      echo "RDS $ID deleted"
    else
      echo "RDS $ID not found (skip)"
    fi

    VPC="$(aws ec2 describe-vpcs --region "$REGION" --filters Name=isDefault,Values=true \
      --query 'Vpcs[0].VpcId' --output text 2>/dev/null || true)"
    if [[ -n "$VPC" && "$VPC" != "None" ]]; then
      SG_ID="$(aws ec2 describe-security-groups --region "$REGION" \
        --filters Name=group-name,Values={{ rds_sg_name }} Name=vpc-id,Values="$VPC" \
        --query 'SecurityGroups[0].GroupId' --output text 2>/dev/null || true)"
      if [[ -n "$SG_ID" && "$SG_ID" != "None" ]]; then
        aws ec2 delete-security-group --group-id "$SG_ID" --region "$REGION" 2>/dev/null \
          && echo "deleted SG {{ rds_sg_name }}" \
          || echo "SG {{ rds_sg_name }} still in use or gone (skip)"
      fi
    fi
    rm -f "{{ rds_creds }}"

# Deploy a single example: `just deploy-one 02_dynamodb`
deploy-one example: (build-one example) whoami
    #!/usr/bin/env bash
    set -euo pipefail
    export PATH="${HOME}/.cargo/bin:${PATH}"
    eval "$(aws configure export-credentials --format env)"
    ROLE="{{ iam_role }}"
    if [[ -z "$ROLE" ]]; then
      ROLE="$(aws iam list-roles \
        --query 'Roles[?starts_with(RoleName, `cargo-lambda-role-`)].Arn | [0]' \
        --output text 2>/dev/null || true)"
      if [[ "$ROLE" == "None" ]]; then ROLE=""; fi
    fi
    case "{{ example }}" in
      01_basic) PKG="{{ fn_01 }}" ;;
      02_dynamodb) PKG="{{ fn_02 }}" ;;
      03_mysql) PKG="{{ fn_03 }}" ;;
      *) echo "unknown example: {{ example }}" >&2; exit 1 ;;
    esac
    cd "{{ justfile_directory() }}/{{ example }}"
    args=(deploy "$PKG" --enable-function-url --region "{{ region }}")
    if [[ -n "$ROLE" ]]; then
      echo "using IAM role: $ROLE"
      args+=(--iam-role "$ROLE")
    fi
    if [[ "{{ example }}" == "02_dynamodb" ]]; then
      args+=(--env-var "TABLE_NAME={{ table_02 }}")
    fi
    cargo lambda "${args[@]}"

# Deploy Lambdas + DynamoDB. Optional paid MySQL: `just deploy with_rds=1`
deploy with_rds="0": whoami install-cargo-lambda _ensure-table-02
    #!/usr/bin/env bash
    set -euo pipefail
    just --justfile "{{ justfile() }}" deploy-one 01_basic
    just --justfile "{{ justfile() }}" deploy-one 02_dynamodb
    just --justfile "{{ justfile() }}" _policy-dynamodb
    just --justfile "{{ justfile() }}" deploy-one 03_mysql
    if [[ "{{ with_rds }}" == "1" || "{{ with_rds }}" == "true" ]]; then
      just --justfile "{{ justfile() }}" _ensure-rds
      just --justfile "{{ justfile() }}" _wire-mysql-env
    fi
    echo
    echo "deployed:"
    eval "$(aws configure export-credentials --format env)"
    for FN in "{{ fn_01 }}" "{{ fn_02 }}" "{{ fn_03 }}"; do
      URL="$(aws lambda get-function-url-config --function-name "$FN" --region "{{ region }}" \
        --query FunctionUrl --output text 2>/dev/null || echo '(no url)')"
      echo "  $FN  $URL"
    done
    echo "DynamoDB table: {{ table_02 }}"
    if [[ "{{ with_rds }}" == "1" || "{{ with_rds }}" == "true" ]]; then
      echo "RDS: {{ rds_id }} (MYSQL_* wired; creds in {{ rds_creds }})"
    else
      echo "03_mysql: no RDS (re-run: just deploy with_rds=1)"
    fi

# Tear down Lambdas, DynamoDB, and our RDS/SG if present.
destroy: whoami
    #!/usr/bin/env bash
    set -euo pipefail
    eval "$(aws configure export-credentials --format env)"
    REGION="{{ region }}"

    delete_fn() {
      local fn="$1"
      if aws lambda get-function --function-name "$fn" --region "$REGION" >/dev/null 2>&1; then
        echo "deleting function $fn"
        aws lambda delete-function --function-name "$fn" --region "$REGION"
      else
        echo "function $fn not found (skip)"
      fi
    }

    if aws lambda get-function --function-name "{{ fn_02 }}" --region "$REGION" >/dev/null 2>&1; then
      ROLE_ARN="$(aws lambda get-function-configuration \
        --function-name "{{ fn_02 }}" --region "$REGION" \
        --query 'Role' --output text)"
      ROLE_NAME="${ROLE_ARN##*/}"
      aws iam delete-role-policy \
        --role-name "$ROLE_NAME" \
        --policy-name "{{ fn_02 }}-dynamodb" 2>/dev/null \
        && echo "removed inline policy {{ fn_02 }}-dynamodb from $ROLE_NAME" \
        || echo "inline policy already gone (skip)"
    fi

    delete_fn "{{ fn_01 }}"
    delete_fn "{{ fn_02 }}"
    delete_fn "{{ fn_03 }}"

    if aws dynamodb describe-table --table-name "{{ table_02 }}" --region "$REGION" >/dev/null 2>&1; then
      echo "deleting table {{ table_02 }}"
      aws dynamodb delete-table --table-name "{{ table_02 }}" --region "$REGION" >/dev/null
      aws dynamodb wait table-not-exists --table-name "{{ table_02 }}" --region "$REGION"
      echo "table {{ table_02 }} deleted"
    else
      echo "table {{ table_02 }} not found (skip)"
    fi

    just --justfile "{{ justfile() }}" _destroy-rds

    echo "destroy done (IAM role cargo-lambda-role-* left in place)."
